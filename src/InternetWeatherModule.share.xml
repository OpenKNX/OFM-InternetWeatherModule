<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
	<op:config name="%IW_NumChannelsDefault%" value="1" />
	<ManufacturerData>
		<Manufacturer>
			<ApplicationPrograms>
				<ApplicationProgram>
					<Static>
						<ParameterTypes>
							<ParameterType Id="%AID%_PT-IWNumChannels" Name="IWNumChannels">
								<TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="%N%" />
							</ParameterType>
							<ParameterType Id="%AID%_PT-APIKEY" Name="API Key">
								<TypeText SizeInBit="320" />
								<!-- 40 characters -->
							</ParameterType>
							<ParameterType Id="%AID%_PT-WeatherCondition" Name="WeatherCondition">
								<TypeText SizeInBit="104" />
								<!-- 14 - 1 prefix =  13 characters -->
							</ParameterType>
							<ParameterType Id="%AID%_PT-WeatherConditionDayPrefix" Name="WeatherConditionDayPrefix">
								<TypeText SizeInBit="8" />
								<!-- 1 character -->
							</ParameterType>
							<ParameterType Id="%AID%_PT-WeatherLocationType" Name="WeatherLocation">
								<TypeRestriction Base="Value" SizeInBit="1">
									<Enumeration Text="Gerätestandort aus Allgemein" Value="0" Id="%ENID%" />
									<Enumeration Text="Anderer Ort" Value="1" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
							<ParameterType Id="%AID%_PT-WeatherRefreshInterval" Name="WeatherRefreshInterval">
								<TypeRestriction Base="Value" SizeInBit="8">
									<Enumeration Text="Keine" Value="0" Id="%ENID%" />
									<Enumeration Text="10 Minuten" Value="1" Id="%ENID%" />
									<Enumeration Text="30 Minuten" Value="2" Id="%ENID%" />
									<Enumeration Text="Jede Stunde" Value="3" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
							<ParameterType Id="%AID%_PT-WeatherChannelType" Name="WeatherChannelType">
								<TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
									<Enumeration Text="Deaktiviert" Value="0" Id="%ENID%" />
									<Enumeration Text="OpenWeatherMap" Value="1" Id="%ENID%" />
									<Enumeration Text="Open-Meteo"     Value="2" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
						</ParameterTypes>
						<Parameters>
							<!-- Base Settings -->
							<Union SizeInBit="8">
								<Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
								<!-- Number of channels -->
								<Parameter Id="%AID%_UP-%TT%00000" Name="VisibleChannels" ParameterType="%AID%_PT-IWNumChannels" Offset="0" BitOffset="0" Text="Verfügbare Kanäle" Value="%IW_NumChannelsDefault%" SuffixText=" von %N%" />
							</Union>
							<!-- OpenWeatherMap API Key -->
							<Union SizeInBit="328">
								<Memory CodeSegment="%MID%" Offset="1" BitOffset="0" />
								<Parameter Id="%AID%_UP-%TT%00001" Name="OpenWeatherMap_APIKey" ParameterType="%AID%_PT-APIKEY" Offset="0" BitOffset="0" Text="API Key" Value="" />
								<!-- 1Byte Empty Byte after String -->
							</Union>
							<!-- WeatherRefreshInterval -->
							<Union SizeInBit="8">
								<Memory CodeSegment="%MID%" Offset="42" BitOffset="0" />
								<Parameter Id="%AID%_UP-%TT%00002" Name="WeatherRefreshInterval" ParameterType="%AID%_PT-WeatherRefreshInterval" Offset="0" BitOffset="0" Text="Automatische Aktualisierung" Value="3" />
							</Union>
							<!-- Weather Condition -->
							<Union SizeInBit="512">
								<Memory CodeSegment="%MID%" Offset="43" BitOffset="0" />
								<Parameter Id="%AID%_UP-%TT%00003" Name="TextPrefixDayCurrent"  ParameterType="%AID%_PT-WeatherConditionDayPrefix" Offset="0"  BitOffset="0" Text="Aktueller Tag" Value="="            />
								<!-- 1 byte empty after string -                                                                                   Offset="1"                                                         -->
								<Parameter Id="%AID%_UP-%TT%00004" Name="TextPrefixDayNext"     ParameterType="%AID%_PT-WeatherConditionDayPrefix" Offset="2"  BitOffset="0" Text="Nächster Tag"  Value=">"            />
								<!-- 1 byte empty after string -                                                                                   Offset="3"                                                         -->
								<Parameter Id="%AID%_UP-%TT%00005" Name="TextSun"               ParameterType="%AID%_PT-WeatherCondition"          Offset="4"  BitOffset="0" Text="Sonne"         Value="Sonne"        />
								<!-- 1 byte empty after string -                                                                                   Offset="17"                                                        -->
								<!-- 1 byte empty after string -                                                                                   Offset="18"                                                        -->
								<Parameter Id="%AID%_UP-%TT%00006" Name="TextClouds"            ParameterType="%AID%_PT-WeatherCondition"          Offset="19" BitOffset="0" Text="Wolken"        Value="Wolken XXX%"  />
								<!-- 1 byte empty after string -                                                                                   Offset="32"                                                        -->
								<!-- 1 byte empty after string -                                                                                   Offset="33"                                                        -->
								<Parameter Id="%AID%_UP-%TT%00007" Name="TextRain"              ParameterType="%AID%_PT-WeatherCondition"          Offset="34" BitOffset="0" Text="Regen"         Value="Regen XXXmm"  />
								<!-- 1 byte empty after string -                                                                                   Offset="47"                                                        -->
								<!-- 1 byte empty after string -                                                                                   Offset="48"                                                        -->
								<Parameter Id="%AID%_UP-%TT%00008" Name="TextSnow"              ParameterType="%AID%_PT-WeatherCondition"          Offset="49" BitOffset="0" Text="Schnee"        Value="Schnee XXXmm" />
								<!-- 1 byte empty after string -                                                                                   Offset="62"                                                        -->
								<!-- 1 byte empty after string -                                                                                   Offset="63"                                                        -->
							</Union>
						</Parameters>
						<ParameterRefs>
							<!-- Number of channels -->
							<ParameterRef Id="%AID%_UP-%TT%00000_R-%TT%0000001" RefId="%AID%_UP-%TT%00000" />
							<!-- OpenWeatherMap API Key -->
							<ParameterRef Id="%AID%_UP-%TT%00001_R-%TT%0000101" RefId="%AID%_UP-%TT%00001" />
							<!-- WeatherRefreshInterval -->
							<ParameterRef Id="%AID%_UP-%TT%00002_R-%TT%0000201" RefId="%AID%_UP-%TT%00002" />
							<!-- WeatherConditionCurrentDayPrefix -->
							<ParameterRef Id="%AID%_UP-%TT%00003_R-%TT%0000301" RefId="%AID%_UP-%TT%00003" />
							<!-- WeatherConditionNextDayPrefix -->
							<ParameterRef Id="%AID%_UP-%TT%00004_R-%TT%0000401" RefId="%AID%_UP-%TT%00004" />
							<!-- WeatherConditionSun -->
							<ParameterRef Id="%AID%_UP-%TT%00005_R-%TT%0000501" RefId="%AID%_UP-%TT%00005" />
							<!-- WeatherConditionClouds -->
							<ParameterRef Id="%AID%_UP-%TT%00006_R-%TT%0000601" RefId="%AID%_UP-%TT%00006" />
							<!-- WeatherConditionRain -->
							<ParameterRef Id="%AID%_UP-%TT%00007_R-%TT%0000701" RefId="%AID%_UP-%TT%00007" />
							<!-- WeatherConditionSnow -->
							<ParameterRef Id="%AID%_UP-%TT%00008_R-%TT%0000801" RefId="%AID%_UP-%TT%00008" />
						</ParameterRefs>
						<ComObjectTable>
							<!-- Refresh Weather Data -->
							<ComObject Id="%AID%_O-%TT%00001" Name="RefreshWeatherData" Text="Wetterdaten aktualisieren" Number="0" FunctionText="Wetterdaten aktualisieren" ObjectSize="1 Bit" ReadFlag="Disabled" WriteFlag="Enabled" CommunicationFlag="Enabled" TransmitFlag="Disabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
						</ComObjectTable>
						<ComObjectRefs>
							<!-- Refresh Weather Data -->
							<ComObjectRef Id="%AID%_O-%TT%00001_R-%TT%0000101" RefId="%AID%_O-%TT%00001" Name="RefreshWeatherData" Priority="Low" ObjectSize="1 Bit" DatapointType="DPST-1-17" />
						</ComObjectRefs>
					</Static>
					<Dynamic>
						<Channel Name="MainChannel%TT%" Text="Internet Wetter" Number="%TT%" Id="%AID%_CH-%TT%" Icon="weather-partly-cloudy">
							<ParameterBlock Id="%AID%_PB-nnn" Name="WeatherSettings" Text="Basiseinstellungen" Icon="earth" HelpContext="Empty">

								<ParameterSeparator Id="%AID%_PS-nnn" Text="Internet Wetter" UIHint="Headline" />
								<ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />

								<ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />

								<!-- IW Client Kanalauswahl -->
								<ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
								<!-- Kanalanzahl -->
								<ParameterRefRef RefId="%AID%_UP-%TT%00000_R-%TT%0000001" />

								<ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />

								<ParameterSeparator Id="%AID%_PS-nnn" Text="OpenWeatherMap" UIHint="Headline" />
								<!-- OpenWeatherMap API Key -->
								<ParameterRefRef RefId="%AID%_UP-%TT%00001_R-%TT%0000101" IndentLevel="1" HelpContext="IW-OpenWeatherMapAPIKey" />

								<ParameterSeparator Id="%AID%_PS-nnn" Text="Open-Meteo" UIHint="Headline" />
								<!-- Open-Meteo API Key not supported yet -->
								<ParameterSeparator Id="%AID%_PS-nnn" Text="  Ohne API-Key ausschließlich NICHT-kommerzielle Nutzung mit limitier Aufruf-Frequenz!" />
								<ParameterSeparator Id="%AID%_PS-nnn" Text="  Die Nutzung eines API-Keys wird bislang nicht unterstützt" />

								<ParameterSeparator Id="%AID%_PS-nnn" Text="Datenaktualisierung" UIHint="Headline" />
								<!-- WeatherRefreshInterval -->
								<ParameterRefRef RefId="%AID%_UP-%TT%00002_R-%TT%0000201" IndentLevel="1" HelpContext="IW-WeatherRefreshInterval" />
								<ParameterSeparator Id="%AID%_PS-nnn" Text="Textbausteine für die Wetterbeschreibung" UIHint="Headline" />
								<!-- WeatherConditionCurrentDayPrefix -->
								<ParameterRefRef RefId="%AID%_UP-%TT%00003_R-%TT%0000301" HelpContext="IW-WeatherConditionCurrentDayPrefix" />
								<!-- WeatherConditionNextDayPrefix -->
								<ParameterRefRef RefId="%AID%_UP-%TT%00004_R-%TT%0000401" HelpContext="IW-WeatherConditionNextDayPrefix" />
								<!-- WeatherConditionSun -->
								<ParameterRefRef RefId="%AID%_UP-%TT%00005_R-%TT%0000501" HelpContext="IW-WeatherConditionSun" />
								<!-- WeatherConditionClouds -->
								<ParameterRefRef RefId="%AID%_UP-%TT%00006_R-%TT%0000601" HelpContext="IW-WeatherConditionClouds" />
								<!-- WeatherConditionRain -->
								<ParameterRefRef RefId="%AID%_UP-%TT%00007_R-%TT%0000701" HelpContext="IW-WeatherConditionRain" />
								<!-- WeatherConditionSnow -->
								<ParameterRefRef RefId="%AID%_UP-%TT%00008_R-%TT%0000801" HelpContext="IW-WeatherConditionSnow" />
								<!-- Refresh Weather Data -->
								<ComObjectRefRef RefId="%AID%_O-%TT%00001_R-%TT%0000101" />
							</ParameterBlock>
							<op:include href="InternetWeatherModule.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/*" type="template" prefix="IW" IsInner="true" />

							<!-- More Page -->
							<choose ParamRefId="%AID%_UP-%TT%00000_R-%TT%0000001">
								<when test="&lt;%N%">
									<ParameterBlock Id="%AID%_PB-nnn" Name="IWAdditionalChannels" Text="(mehr)" Icon="dots-horizontal">										<!-- HelpContext="Empty" -->
										<ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
										<ParameterRefRef RefId="%AID%_UP-%TT%00000_R-%TT%0000001" />
										<!-- HelpContext="BASE-Verfuegbare-Kanaele" IndentLevel="1" /-->
									</ParameterBlock>
								</when>
							</choose>
						</Channel>
					</Dynamic>
				</ApplicationProgram>
			</ApplicationPrograms>
			<Baggages>
				<Baggage TargetPath="" Name="Help_de.zip" Id="%FILE-HELP-de%">
					<FileInfo TimeInfo="%DATETIME%" />
				</Baggage>
				<Baggage TargetPath="" Name="Icons.zip" Id="%FILE-ICONS%">
					<FileInfo TimeInfo="%DATETIME%" />
				</Baggage>
			</Baggages>
		</Manufacturer>
	</ManufacturerData>
</KNX>
